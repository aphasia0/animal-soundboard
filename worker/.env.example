# Copia questo file in worker/.env e riempi i valori.
# worker/.env non deve essere committato.

# Token richiesto da n8n:
#   Authorization: Bearer <WORKER_TOKEN>
WORKER_TOKEN=cambia-con-un-token-lungo-e-casuale

# Supabase
# upload-card.js usa il login utente (non service_role).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=incolla-qui-la-anon-key
SUPABASE_EMAIL=la-tua-email@example.com
SUPABASE_PASSWORD=la-tua-password

# AI
# GEMINI_API_KEY serve per immagini (Nano Banana) e musica (Lyria).
GEMINI_API_KEY=
# GOOGLE_TTS_API_KEY serve per audio-mode=voice.
GOOGLE_TTS_API_KEY=
# ELEVENLABS_API_KEY serve per audio-mode=effects.
ELEVENLABS_API_KEY=

# Worker
PORT=8787
MAX_QUEUE=2
JOB_TIMEOUT_MS=600000
MAX_LOG_CHARS=20000
# MAX_BODY_BYTES=262144

# Compose (opzionali)
# WORKER_PORT=8787
# WORKER_IMAGE=soundpad-worker:armv7
